# Centralized color palette — darker Tokyo Night with electric purple accents
{
  # Base16 scheme (used by Stylix and as canonical reference)
  base00 = "0F1117"; # Background (deeper than Tokyo Night)
  base01 = "161822"; # Surface / raised bg
  base02 = "1E2030"; # Selection / subtle highlight
  base03 = "3B4261"; # Comments / muted text
  base04 = "7982A9"; # Dark foreground / line numbers
  base05 = "A9B1D6"; # Default foreground
  base06 = "C0CAF5"; # Light foreground
  base07 = "D5D6DB"; # Bright foreground
  base08 = "F7768E"; # Red / errors
  base09 = "FF9E64"; # Orange / warnings
  base0A = "E0AF68"; # Yellow
  base0B = "9ECE6A"; # Green / success
  base0C = "7DCFFF"; # Cyan / info
  base0D = "B24EFF"; # Electric purple — primary accent
  base0E = "BB9AF7"; # Lavender / secondary accent
  base0F = "DB7093"; # Rose / misc

  # Semantic aliases for convenience
  bg = "0F1117";
  bg-surface = "161822";
  bg-highlight = "1E2030";
  fg-muted = "3B4261";
  fg = "A9B1D6";
  fg-bright = "C0CAF5";
  accent = "B24EFF";
  accent-soft = "BB9AF7";
  red = "F7768E";
  orange = "FF9E64";
  yellow = "E0AF68";
  green = "9ECE6A";
  cyan = "7DCFFF";
  rose = "DB7093";
}
